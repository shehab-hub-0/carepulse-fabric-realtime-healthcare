.execute database script with (ThrowOnErrors=true)
<|
.create-merge table synthea_raw (payload: dynamic)
.create-or-alter table synthea_raw ingestion json mapping 'synthea_raw_json_mapping' '[{"column":"payload","path":"$.payload","datatype":"dynamic"}]'
.alter table synthea_raw policy streamingingestion enable
// --- Silver Table: patients ---
.create-merge table patients (["event_id"]: string, ["event_type"]: string, ["event_time"]: datetime, ["clinical_time"]: datetime, ["batch_id"]: long, ["seq"]: long, ["sim_state"]: string, ["schema_version"]: string, ["source_system"]: string, ["id"]: string, ["birthdate"]: datetime, ["deathdate"]: datetime, ["ssn"]: string, ["drivers"]: string, ["passport"]: string, ["prefix"]: string, ["first"]: string, ["middle"]: string, ["last"]: string, ["suffix"]: string, ["maiden"]: string, ["marital"]: string, ["race"]: string, ["ethnicity"]: string, ["gender"]: string, ["birthplace"]: string, ["address"]: string, ["city"]: string, ["state"]: string, ["county"]: string, ["fips"]: string, ["zip"]: string, ["lat"]: real, ["lon"]: real, ["healthcare_expenses"]: real, ["healthcare_coverage"]: real, ["income"]: long)
.create-or-alter function parse_patients() { synthea_raw | where tostring(payload["event_type"]) == "patients" | project ["event_id"] = tostring(payload["event_id"]), ["event_type"] = tostring(payload["event_type"]), ["event_time"] = todatetime(payload["event_time"]), ["clinical_time"] = todatetime(payload["clinical_time"]), ["batch_id"] = tolong(payload["batch_id"]), ["seq"] = tolong(payload["seq"]), ["sim_state"] = tostring(payload["sim_state"]), ["schema_version"] = tostring(payload["schema_version"]), ["source_system"] = tostring(payload["source_system"]), ["id"] = tostring(payload["id"]), ["birthdate"] = todatetime(payload["birthdate"]), ["deathdate"] = todatetime(payload["deathdate"]), ["ssn"] = tostring(payload["ssn"]), ["drivers"] = tostring(payload["drivers"]), ["passport"] = tostring(payload["passport"]), ["prefix"] = tostring(payload["prefix"]), ["first"] = tostring(payload["first"]), ["middle"] = tostring(payload["middle"]), ["last"] = tostring(payload["last"]), ["suffix"] = tostring(payload["suffix"]), ["maiden"] = tostring(payload["maiden"]), ["marital"] = tostring(payload["marital"]), ["race"] = tostring(payload["race"]), ["ethnicity"] = tostring(payload["ethnicity"]), ["gender"] = tostring(payload["gender"]), ["birthplace"] = tostring(payload["birthplace"]), ["address"] = tostring(payload["address"]), ["city"] = tostring(payload["city"]), ["state"] = tostring(payload["state"]), ["county"] = tostring(payload["county"]), ["fips"] = tostring(payload["fips"]), ["zip"] = tostring(payload["zip"]), ["lat"] = toreal(payload["lat"]), ["lon"] = toreal(payload["lon"]), ["healthcare_expenses"] = toreal(payload["healthcare_expenses"]), ["healthcare_coverage"] = toreal(payload["healthcare_coverage"]), ["income"] = tolong(payload["income"]) }
.alter table patients policy update @'[{"IsEnabled":true,"Source":"synthea_raw","Query":"parse_patients()","IsTransactional":false,"PropagateIngestionProperties":false}]'
