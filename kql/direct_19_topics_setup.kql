.execute database script with (ThrowOnErrors=true)
<|
// --- Table: patients (Kafka topic: synthea.patients) ---
.create-merge table patients (["event_id"]: string, ["event_type"]: string, ["event_time"]: datetime, ["clinical_time"]: datetime, ["batch_id"]: long, ["seq"]: long, ["sim_state"]: string, ["schema_version"]: string, ["source_system"]: string, ["id"]: string, ["birthdate"]: datetime, ["deathdate"]: datetime, ["ssn"]: string, ["drivers"]: string, ["passport"]: string, ["prefix"]: string, ["first"]: string, ["middle"]: string, ["last"]: string, ["suffix"]: string, ["maiden"]: string, ["marital"]: string, ["race"]: string, ["ethnicity"]: string, ["gender"]: string, ["birthplace"]: string, ["address"]: string, ["city"]: string, ["state"]: string, ["county"]: string, ["fips"]: string, ["zip"]: string, ["lat"]: real, ["lon"]: real, ["healthcare_expenses"]: real, ["healthcare_coverage"]: real, ["income"]: long)
.create-or-alter table patients ingestion json mapping 'patients_json_mapping' '[{"column":"event_id","path":"$.event_id","datatype":"string"},{"column":"event_type","path":"$.event_type","datatype":"string"},{"column":"event_time","path":"$.event_time","datatype":"datetime"},{"column":"clinical_time","path":"$.clinical_time","datatype":"datetime"},{"column":"batch_id","path":"$.batch_id","datatype":"long"},{"column":"seq","path":"$.seq","datatype":"long"},{"column":"sim_state","path":"$.sim_state","datatype":"string"},{"column":"schema_version","path":"$.schema_version","datatype":"string"},{"column":"source_system","path":"$.source_system","datatype":"string"},{"column":"id","path":"$.id","datatype":"string"},{"column":"birthdate","path":"$.birthdate","datatype":"datetime"},{"column":"deathdate","path":"$.deathdate","datatype":"datetime"},{"column":"ssn","path":"$.ssn","datatype":"string"},{"column":"drivers","path":"$.drivers","datatype":"string"},{"column":"passport","path":"$.passport","datatype":"string"},{"column":"prefix","path":"$.prefix","datatype":"string"},{"column":"first","path":"$.first","datatype":"string"},{"column":"middle","path":"$.middle","datatype":"string"},{"column":"last","path":"$.last","datatype":"string"},{"column":"suffix","path":"$.suffix","datatype":"string"},{"column":"maiden","path":"$.maiden","datatype":"string"},{"column":"marital","path":"$.marital","datatype":"string"},{"column":"race","path":"$.race","datatype":"string"},{"column":"ethnicity","path":"$.ethnicity","datatype":"string"},{"column":"gender","path":"$.gender","datatype":"string"},{"column":"birthplace","path":"$.birthplace","datatype":"string"},{"column":"address","path":"$.address","datatype":"string"},{"column":"city","path":"$.city","datatype":"string"},{"column":"state","path":"$.state","datatype":"string"},{"column":"county","path":"$.county","datatype":"string"},{"column":"fips","path":"$.fips","datatype":"string"},{"column":"zip","path":"$.zip","datatype":"stri