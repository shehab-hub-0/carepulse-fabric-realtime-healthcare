// =============================================================================
// CarePulse - Gold Data Cleaning & Enrichment Layer (Microsoft Fabric Eventhouse)
// Paste into CarePulse_EH KQL Queryset, click inside line 6+, and press Run ONCE.
// =============================================================================
.execute database script with (ThrowOnErrors=true)
<|
// 1. Clean & deduplicated patients (removes Synthea digit suffixes, computes age & age_group)
.create-or-alter function clean_patients() { patients | summarize arg_max(event_time, *) by id | extend first_name = replace_regex(["first"], @"\d+$", ""), middle_name = replace_regex(coalesce(middle, ""), @"\d+$", ""), last_name = replace_regex(["last"], @"\d+$", ""), is_deceased = isnotnull(deathdate), age_years = datetime_diff('year', coalesce(deathdate, now()), birthdate), marital_status = iff(isempty(marital), "Unknown", marital) | extend full_name = trim(" ", strcat(first_name, " ", last_name)), age_group = case(age_years < 18, "0-17 Pediatric", age_years < 35, "18-34 Young Adult", age_years < 55, "35-54 Adult", age_years < 65, "55-64 Senior", "65+ Elderly") | project id, full_name, first_name, middle_name, last_name, gender, birthdate, deathdate, is_deceased, age_years, age_group, marital_status, race, ethnicity, city, patient_state = ["state"], zip, lat, lon, healthcare_expenses, healthcare_coverage, income, sim_state, event_time }
// 2. Clean & deduplicated clinicians/providers
.create-or-alter function clean_providers() { providers | summarize arg_max(event_time, *) by id | extend provider_name = trim(" ", replace_regex(replace_regex(["name"], @"\d+(\s|$)", @"\1"), @"\s+", " ")), speciality = iff(isempty(speciality), "General Practice", speciality) | project id, organization, provider_name, gender, speciality, city, provider_state = ["state"], zip, lat, lon, encounters, procedures, npi, event_time }
// 3. Clean & deduplicated encounters (duration_minutes, out_of_pocket, normalized reason)
.create-or-alter function clean_encounters() { encounters | summarize arg_max(event_time, *) by id | extend start_time = ["start"], stop_time = ["stop"], duration_minutes = iff(isnotnull(["stop"]) and isnotnull(["start"]) and ["stop"] >= ["start"], datetime_diff('minute', ["stop"], ["start"]), long(null)), out_of_pocket = max_of(0.0, total_claim_cost - payer_coverage), reason = iff(isempty(reasondescription), "Routine / Unspecified", reasondescription), is_acute = encounterclass in ("emergency", "inpatient", "urgentcare") | project id, patient, organization, provider, payer, encounterclass, is_acute, code, description, reasoncode, reason, start_time, stop_time, duration_minutes, base_encounter_cost, total_claim_cost, payer_coverage, out_of_pocket, sim_state, event_time }
// 4. Clean & enriched hospitals/organizations (computes actual_revenue from encounters since raw revenue is 0)
.create-or-alter function clean_organizations() { organizations | summarize arg_max(event_time, *) by id | join kind=leftouter (clean_encounters() | summarize encounter_count = count(), er_encounters = countif(encounterclass == "emergency"), inpatient_encounters = countif(encounterclass == "inpatient"), actual_revenue = round(sum(total_claim_cost), 2), total_payer_coverage = round(sum(payer_coverage), 2), total_out_of_pocket = round(sum(out_of_pocket), 2), unique_patients = dcount(patient) by organization) on $left.id == $right.organization | project id, hospital_name = ["name"], address, city, hospital_state = ["state"], zip, lat, lon, phone, npi, utilization, encounter_count = coalesce(encounter_count, 0), er_encounters = coalesce(er_encounters, 0), inpatient_encounters = coalesce(inpatient_encounters, 0), actual_revenue = coalesce(actual_revenue, 0.0), total_payer_coverage = coalesce(total_payer_coverage, 0.0), total_out_of_pocket = coalesce(total_out_of_pocket, 0.0), unique_patients = coalesce(unique_patients, 0), event_time }
// 5. Clean & deduplicated diagnoses/conditions (separates medical disorders from SDOH/admin notes)
.create-or-alter function clean_conditions() { conditions | summarize arg_max(event_time, *) by event_id | extend start_time = ["start"], stop_time = ["stop"], is_active = isnull(["stop"]), duration_days = iff(isnotnull(["stop"]) and ["stop"] >= ["start"], datetime_diff('day', ["stop"], ["start"]), long(null)), clean_description = trim(" ", replace_regex(description, @"\s*\((disorder|finding|situation)\)$", "")), condition_category = case(description has "(disorder)", "Medical Disorder", description has_any ("employment", "labor force", "education", "High school", "Social isolation", "Limited social contact", "housing", "Unemployed", "Transport", "violence", "abuse", "criminal"), "Social Determinant (SDOH)", description has "(situation)", "Administrative / History", "Clinical Finding") | project event_id, patient, encounter, system, code, description, clean_description, condition_category, start_time, stop_time, is_active, duration_days, sim_state, event_time }
// 6. Clean observations (separates clinical vitals/labs from surveys & flags abnormal readings)
.create-or-alter function clean_observations() { observations | summarize arg_max(event_time, *) by event_id | extend obs_date = ["date"], obs_value = ["value"], obs_type = ["type"], obs_category = iff(isempty(category), "uncategorized", category) | extend clinical_domain = case(obs_category in ("vital-signs", "laboratory"), "Clinical Labs & Vitals", obs_category == "survey", "Surveys", "Social & Other"), alert_level = case(code == "8480-6" and numeric_value >= 180.0, "Critical", code == "8480-6" and (numeric_value >= 140.0 or numeric_value < 90.0), "Elevated", code == "8462-4" and numeric_value >= 120.0, "Critical", code == "8462-4" and (numeric_value >= 90.0 or numeric_value < 60.0), "Elevated", code == "8867-4" and (numeric_value >= 130.0 or numeric_value < 45.0), "Critical", code == "8867-4" and (numeric_value > 100.0 or numeric_value < 55.0), "Elevated", code == "72514-3" and numeric_value >= 7.0, "Elevated", code == "39156-5" and numeric_value >= 30.0, "Elevated", "Normal") | extend is_abnormal = alert_level != "Normal" | project event_id, patient, encounter, obs_date, obs_category, clinical_domain, code, description, obs_value, numeric_value, units, obs_type, alert_level, is_abnormal, sim_state, event_time }
// 7. Clean & deduplicated medications
.create-or-alter function clean_medications() { medications | summarize arg_max(event_time, *) by event_id | extend start_time = ["start"], stop_time = ["stop"], is_active = isnull(["stop"]), out_of_pocket = max_of(0.0, totalcost - payer_coverage), reason = iff(isempty(reasondescription), "Standard Prescription", reasondescription) | project event_id, patient, payer, encounter, code, description, start_time, stop_time, is_active, base_cost, payer_coverage, dispenses, totalcost, out_of_pocket, reason, sim_state, event_time }
// 8. Clean & deduplicated financial claims transactions
.create-or-alter function clean_claims_transactions() { claims_transactions | summarize arg_max(event_time, *) by id | extend tx_type = ["type"], payment_method = iff(isempty(method), "INSURANCE/OTHER", method), charge_amount = iff(["type"] == "CHARGE", coalesce(amount, 0.0), 0.0), payment_amount = iff(["type"] == "PAYMENT", coalesce(payments, 0.0), 0.0), transfer_amount = iff(["type"] in ("TRANSFERIN", "TRANSFEROUT"), coalesce(transfers, amount, 0.0), 0.0) | project id, claimid, chargeid, patientid, providerid, appointmentid, tx_type, payment_method, amount, payments, adjustments, transfers, outstanding, charge_amount, payment_amount, transfer_amount, fromdate, todate, procedurecode, notes, sim_state, event_time }
// 9. Data Quality & Streaming Health Monitor
.create-or-alter function dq_pipeline_health() { union (synthea_raw | extend ingest_ts = ingestion_time(), evt_ts = todatetime(payload["event_time"]) | summarize TotalRows = count(), IssueRows = countif(isnull(payload)), AvgLatencySec = round(avg(datetime_diff('second', ingest_ts, evt_ts)), 2) | extend CheckName = "1_Raw_Stream_Ingestion"), (observations | summarize TotalRows = count(), IssueRows = countif(isempty(category) or category == "uncategorized") | extend CheckName = "2_Observations_Categorized", AvgLatencySec = real(null)), (encounters | summarize TotalRows = count(), IssueRows = countif(isnull(["stop"]) or ["stop"] < ["start"]) | extend CheckName = "3_Encounters_Valid_Timestamps", AvgLatencySec = real(null)), (organizations | summarize arg_max(event_time, *) by id | summarize TotalRows = count(), IssueRows = countif(revenue == 0.0) | extend CheckName = "4_Hospitals_Raw_Revenue_Fixed_In_Gold", AvgLatencySec = real(null)), (synthea_dlq | summarize TotalRows = count(), IssueRows = count() | extend CheckName = "5_Dead_Letter_Queue_Errors", AvgLatencySec = real(null)) | project CheckName, TotalRows, IssueRows, HealthyPct = iff(TotalRows == 0, 100.0, round(100.0 * (TotalRows - IssueRows) / TotalRows, 2)), AvgLatencySec | order by CheckName asc }
